# ============================================================
# CodeSage — Local AI Code Reviewer
# Copy this file to .env and adjust as needed.
# ============================================================

# Ollama server endpoint (default: local)
OLLAMA_BASE_URL=http://localhost:11434

# Default model to use (must be pulled via: ollama pull <model>)
# Recommended: gemma3, codellama, deepseek-coder, phi4
OLLAMA_MODEL=gemma3

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Maximum number of tokens in model response
MAX_TOKENS=2048

# Request timeout in seconds
REQUEST_TIMEOUT=120

# Output format: rich | plain | json
OUTPUT_FORMAT=rich
